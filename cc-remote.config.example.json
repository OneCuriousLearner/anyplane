{
  "$comment": "复制为 cc-remote.config.json 使用（该文件已被 gitignore，勿提交机器相关路径）。所有字段均可选；claudePath/claudeConfigDir 建议优先用 PATH / CLAUDE_CONFIG_DIR 环境变量按机器覆盖。绑定非回环 host 必须配置 authToken。",
  "port": 7480,
  "host": "127.0.0.1",
  "authToken": "",
  "permissionPolicy": "ask",
  "claudePath": "/abs/path/to/claude",
  "detachRecycleMs": 300000,
  "idleTimeoutMs": 1800000,
  "claudeConfigDir": "/abs/path/to/.claude",
  "gateway": {
    "httpPort": 80,
    "httpsPort": 443,
    "prodHost": "cc-remote.devcloud.woa.com",
    "devHost": "cc-remote-dev.devcloud.woa.com",
    "muxSsh": true
  }
}
